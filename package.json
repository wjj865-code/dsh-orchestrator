{
  "name": "@wjj865-code/dsh-orchestrator",
  "version": "0.33.0",
  "description": "给 DeepSeek Harness 加一位协调者：主会话拆活派子会话，进度与结论落进持久台账，带任务台、能力包、跨项目记忆与自动化。",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./preset-tools": "./preset-tools.js",
    "./skill-grill-me": "./skill-grill-me.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "dist/",
    "packs/",
    "preset-tools.js",
    "skill-grill-me.js",
    "skills/",
    "src/",
    "scripts/",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/CONFIG.md",
    "docs/TOOLS.md",
    "docs/testing.md",
    "docs/ARCHITECTURE.md",
    "docs/compat.md",
    "docs/LIMITATIONS.md",
    "docs/CONTRIBUTING.md",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.15",
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjj865-code/dsh-orchestrator.git"
  },
  "homepage": "https://github.com/wjj865-code/dsh-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/wjj865-code/dsh-orchestrator/issues"
  },
  "scripts": {
    "build": "vite build --config vite.client.config.mjs",
    "pretest": "pnpm run build && node scripts/check-client-size.mjs && pnpm run check:docs",
    "test": "node --test --experimental-test-isolation=none --disable-warning=ExperimentalWarning \"test/*.test.js\"",
    "check:client": "node --check dist/client.js",
    "check:client-size": "node scripts/check-client-size.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "mirror:sync": "node scripts/mirror-sync.mjs",
    "mirror:check": "node scripts/mirror-sync.mjs --check",
    "prepublishOnly": "pnpm test && pnpm run check:client && pnpm run check:client-size && pnpm run check:version && pnpm run check:docs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "orchestrator",
    "tasks"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "vite": "7.3.8"
  }
}
