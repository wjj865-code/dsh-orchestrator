{
  "name": "@wjj865-code/dsh-orchestrator",
  "version": "0.12.0",
  "description": "Coordinator + task sessions for DeepSeek Harness: durable task ledger, cross-project memory, dependency orchestration, inbox/digest, snapshots, and a browser task panel.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./preset-tools": "./preset-tools.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "preset-tools.js",
    "src/",
    "scripts/",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/ARCHITECTURE.md",
    "docs/LIMITATIONS.md",
    "docs/DEBUG-PRESET.md",
    "docs/UI.md",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjj865-code/dsh-orchestrator.git"
  },
  "homepage": "https://github.com/wjj865-code/dsh-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/wjj865-code/dsh-orchestrator/issues"
  },
  "scripts": {
    "build": "vite build --config vite.client.config.mjs",
    "pretest": "npm run build",
    "test": "node --test --experimental-test-isolation=none --disable-warning=ExperimentalWarning \"test/*.test.js\"",
    "check:client": "node --check dist/client.js",
    "preset:debug": "node scripts/orch-debug-preset.mjs",
    "preset:debug:check": "node scripts/orch-debug-preset.mjs --check",
    "mirror:sync": "node scripts/mirror-sync.mjs",
    "mirror:check": "node scripts/mirror-sync.mjs --check",
    "prepublishOnly": "npm test && npm run check:client"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "orchestrator",
    "tasks"
  ],
  "devDependencies": {
    "vite": "7.3.8"
  }
}
