{
  "name": "@wjj865-code/dsh-orchestrator",
  "version": "0.3.1",
  "description": "Coordinator + task sessions for DeepSeek Harness: durable task ledger, cross-project memory, project context, progress reports, interrupt-controlled notifications, snapshots, and a browser task panel.",
  "type": "module",
  "main": "index.js",
  "exports": { ".": "./index.js", "./client": "./client.js", "./preset-tools": "./preset-tools.js" },
  "files": ["index.js", "client.js", "preset-tools.js", "src/", "cordis.patch.yml", "README.md"],
  "engines": { "node": ">=22.15" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjj865-code/dsh-orchestrator.git"
  },
  "homepage": "https://github.com/wjj865-code/dsh-orchestrator#readme",
  "bugs": { "url": "https://github.com/wjj865-code/dsh-orchestrator/issues" },
  "scripts": {
    "test": "node --test --experimental-test-isolation=none --disable-warning=ExperimentalWarning \"test/*.test.js\"",
    "check:client": "node --check client.js",
    "prepublishOnly": "npm test && npm run check:client"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "orchestrator", "tasks"]
}
